{
    "name": "plugin-site",
    "private": true,
    "description": "plugins.jenkins.io website",
    "main": "index.js",
    "scripts": {
        "lint": "eslint -c eslint.config.mjs .",
        "test": "yarn workspaces foreach --worktree -t -p -v -i run test",
        "build": "yarn workspaces foreach --worktree -t -p -v -i run build",
        "dev": "yarn workspace @jenkins-cd/jenkins-plugin-site dev",
        "postinstall": "husky install"
    },
    "workspaces": [
        "plugins/*"
    ],
    "version": "0.0.1",
    "devDependencies": {
        "@babel/eslint-parser": "8.1.2",
        "@babel/eslint-plugin": "8.1.0",
        "@babel/plugin-proposal-decorators": "8.0.2",
        "eslint": "10.15.0",
        "eslint-config-google": "0.14.0",
        "eslint-plugin-filenames": "^1.3.2",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.7.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.1"
    },
    "lint-staged": {
        "*.{js,jsx}": [
            "eslint --fix"
        ]
    },
    "packageManager": "yarn@4.19.0",
    "resolutions": {
        "lmdb@npm:2.5.2": "npm:lmdb@3.5.11",
        "lmdb@npm:2.5.3": "npm:lmdb@3.5.11",
        "eslint-plugin-jest/@typescript-eslint/utils": "8.73.0",
        "sharp": "0.35.5"
    }
}

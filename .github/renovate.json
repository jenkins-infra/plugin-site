{
    "extends": [
        "config:recommended"
    ],
    "labels": [
        "dependencies"
    ],
    "npm": {
        "minimumReleaseAge": "3 days"
    },
    "rebaseWhen": "conflicted",
    "packageRules": [
        {
            "matchPackageNames": [
                "node"
            ],
            "major": {
                "enabled": true
            },
            "separateMultipleMajor": true,
            "allowedVersions": "^20"
        },
        {
            "extends": [
                "monorepo:remark"
            ],
            "enabled": false
        },
        {
            "matchPackageNames": [
                "husky"
            ],
            "enabled": false
        },
        {
            "matchUpdateTypes": [
                "minor",
                "patch",
                "pin",
                "digest"
            ],
            "automerge": true
        }
    ]
}
